{
	"name": "vox",
	"version": "3.1.2",
	"description": "Agent-facing speech to text and text to speech over Alibaba Model Studio.",
	"repository": "https://github.com/celados/vox",
	"bin": {
		"vox": "./src/main.ts"
	},
	"type": "module",
	"scripts": {
		"start": "bun run src/main.ts",
		"schema": "bun run src/main.ts @schema",
		"fmt": "vp fmt",
		"typecheck": "harness typecheck",
		"test": "bun test",
		"check": "vp check && harness typecheck && fallow dead-code && bun test",
		"build": "bun build src/main.ts --outfile=dist/vox --target=bun --minify && chmod +x dist/vox",
		"prepare": "vp config"
	},
	"dependencies": {
		"@celados/argc": "^11.0.0",
		"@celados/argc-latch": "^1.0.0",
		"@valibot/to-json-schema": "^1.8.0",
		"valibot": "^1.5.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@celados/harness": "^0.1.3",
		"@types/bun": "^1.3.14",
		"fallow": "^3.42.0",
		"tsrs": "0.24.0-ts7.1.0-beta",
		"typescript": "^7.0.2",
		"vite-plus": "^1.6.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
