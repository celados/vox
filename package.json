{
  "name": "vox",
  "version": "1.0.0",
  "description": "Agent-facing speech to text and text to speech over Alibaba Model Studio.",
  "repository": "https://github.com/celados/vox",
  "bin": {
    "vox": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "schema": "bun run src/main.ts @schema",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run fmt:check && bun run typecheck && bun test",
    "build": "bun build src/main.ts --outfile=dist/vox --target=bun --minify && chmod +x dist/vox"
  },
  "dependencies": {
    "@celados/argc": "^7.11.0",
    "@valibot/to-json-schema": "^1.7.1",
    "valibot": "^1.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.64.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
